# Included only by package-tools.cmake, using its configured compiler and tools.
set(dependencies "Source SHA: ${source_sha}\nHost: ${CMAKE_HOST_SYSTEM_NAME} ${architecture}\nCompiler: ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\nCompiler path: ${CMAKE_CXX_COMPILER}\n")

function(audit label)
    capture(output ${ARGN})
    string(APPEND dependencies "\n${label}\n${output}\n")
    set(dependencies "${dependencies}" PARENT_SCOPE)
    set(audit_output "${output}" PARENT_SCOPE)
endfunction()

function(copy_notices source name)
    foreach(required IN LISTS ARGN)
        if(NOT EXISTS "${source}/${required}")
            message(FATAL_ERROR "Required actual-toolchain notice is missing: ${source}/${required}")
        endif()
    endforeach()
    file(GLOB_RECURSE notices LIST_DIRECTORIES false RELATIVE "${source}" "${source}/*")
    if(NOT notices)
        message(FATAL_ERROR "No actual-toolchain notices in ${source}")
    endif()
    file(MAKE_DIRECTORY "${package_root}/third-party-licenses/${name}")
    file(COPY "${source}/" DESTINATION "${package_root}/third-party-licenses/${name}")
    foreach(notice IN LISTS notices)
        file(SHA256 "${source}/${notice}" notice_sha)
        string(APPEND dependencies "Notice: ${name}/${notice} SHA256 ${notice_sha}; origin ${source}/${notice}\n")
    endforeach()
    set(dependencies "${dependencies}" PARENT_SCOPE)
endfunction()

if(platform STREQUAL "windows-mingw")
    get_filename_component(compiler_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
    get_filename_component(compiler_prefix "${compiler_bin}/.." REALPATH)
    find_program(OBJDUMP_EXECUTABLE objdump HINTS "${compiler_bin}" NO_DEFAULT_PATH REQUIRED)
    find_program(PACMAN_EXECUTABLE pacman HINTS "${compiler_prefix}/../usr/bin" NO_DEFAULT_PATH REQUIRED)
    audit("Installed MSYS2 packages from the configured toolchain" "${PACMAN_EXECUTABLE}" -Q)
    audit("Compiler target" "${CMAKE_CXX_COMPILER}" -dumpmachine)
    audit("Compiler version" "${CMAKE_CXX_COMPILER}" --version)
    copy_notices("${compiler_prefix}/share/licenses/crt" crt COPYING COPYING.MinGW-w64-runtime.txt)
    if(EXISTS "${compiler_prefix}/share/licenses/libstdc++")
        set(cxx_notices "${compiler_prefix}/share/licenses/libstdc++")
    else()
        set(cxx_notices "${compiler_prefix}/share/licenses/gcc-libs")
    endif()
    copy_notices("${cxx_notices}" libstdc++ COPYING3 COPYING.RUNTIME)
    copy_notices("${compiler_prefix}/share/licenses/libwinpthread" libwinpthread COPYING)
    foreach(tool IN ITEMS discc discas discld)
        audit("${tool}: PE headers/import table" "${OBJDUMP_EXECUTABLE}" -p "${package_root}/bin/${tool}.exe")
        string(TOLOWER "${audit_output}" imports)
        if(NOT imports MATCHES "dll name:" OR imports MATCHES "dll name:[^\n]*(libstdc[+][+]|libgcc|libwinpthread|libssp|libquadmath|libgomp|msys-2|cygwin1)")
            message(FATAL_ERROR "Missing PE import evidence or dynamic GCC/MinGW runtime import in ${tool}")
        endif()
    endforeach()
    set(requirements "Windows ${architecture} with Universal CRT and the Windows system DLLs listed in DEPENDENCIES.txt. GCC/libstdc++/winpthread runtimes are statically linked; their actual toolchain notices are included. Extracted smoke runs with only Windows system directories on PATH, without MinGW/MSYS2 directories.")
elseif(platform STREQUAL "windows-msvc")
    find_program(DUMPBIN_EXECUTABLE dumpbin REQUIRED)
    foreach(tool IN ITEMS discc discas discld)
        audit("${tool}: PE machine/header" "${DUMPBIN_EXECUTABLE}" /HEADERS "${package_root}/bin/${tool}.exe")
        audit("${tool}: DLL requirements" "${DUMPBIN_EXECUTABLE}" /DEPENDENTS "${package_root}/bin/${tool}.exe")
    endforeach()
    set(requirements "Windows ${architecture}; requires Universal CRT and a compatible Microsoft Visual C++ v14 Redistributable matching the architecture for the recorded MSVC toolset. See the actual imported DLLs in DEPENDENCIES.txt. Microsoft runtime DLLs are not bundled. The CI developer machine having these runtimes installed does not prove they are present on a clean end-user machine.")
elseif(platform STREQUAL "linux")
    find_program(READELF_EXECUTABLE readelf REQUIRED)
    find_program(LDD_EXECUTABLE ldd REQUIRED)
    find_program(FILE_EXECUTABLE file REQUIRED)
    audit("Compiler version" "${CMAKE_CXX_COMPILER}" --version)
    audit("Host runtime version" "${LDD_EXECUTABLE}" --version)
    audit("Build host distribution" "${CMAKE_COMMAND}" -E cat /etc/os-release)
    set(glibc_versions "")
    set(glibcxx_versions "")
    foreach(tool IN ITEMS discc discas discld)
        audit("${tool}: binary architecture" "${FILE_EXECUTABLE}" "${package_root}/bin/${tool}")
        audit("${tool}: runtime resolution" "${LDD_EXECUTABLE}" "${package_root}/bin/${tool}")
        if(audit_output MATCHES "not found")
            message(FATAL_ERROR "Unresolved runtime dependency in ${tool}")
        endif()
        audit("${tool}: ELF version requirements" "${READELF_EXECUTABLE}" --version-info --wide "${package_root}/bin/${tool}")
        string(REGEX MATCHALL "GLIBC_[0-9.]+" versions "${audit_output}")
        list(APPEND glibc_versions ${versions})
        string(REGEX MATCHALL "GLIBCXX_[0-9.]+" versions "${audit_output}")
        list(APPEND glibcxx_versions ${versions})
    endforeach()
    if(NOT glibc_versions OR NOT glibcxx_versions)
        message(FATAL_ERROR "Missing required GLIBC/GLIBCXX version evidence")
    endif()
    list(SORT glibc_versions COMPARE NATURAL ORDER DESCENDING)
    list(SORT glibcxx_versions COMPARE NATURAL ORDER DESCENDING)
    list(GET glibc_versions 0 glibc_floor)
    list(GET glibcxx_versions 0 glibcxx_floor)
    set(requirements "Linux ${architecture}, dynamic glibc/libstdc++ build. Requires at least ${glibc_floor} and a libstdc++ providing ${glibcxx_floor}; all ELF/runtime details are in DEPENDENCIES.txt. Not a static or all-distributions Linux binary. System shared libraries are not bundled.")
elseif(platform STREQUAL "macos")
    find_program(OTOOL_EXECUTABLE otool REQUIRED)
    find_program(FILE_EXECUTABLE file REQUIRED)
    audit("Compiler version" "${CMAKE_CXX_COMPILER}" --version)
    set(deployment_versions "")
    foreach(tool IN ITEMS discc discas discld)
        audit("${tool}: binary architecture" "${FILE_EXECUTABLE}" "${package_root}/bin/${tool}")
        audit("${tool}: dynamic libraries" "${OTOOL_EXECUTABLE}" -L "${package_root}/bin/${tool}")
        audit("${tool}: Mach-O deployment target" "${OTOOL_EXECUTABLE}" -l "${package_root}/bin/${tool}")
        string(REGEX MATCH "minos[ \t]+([0-9]+\\.[0-9.]+)" deployment "${audit_output}")
        if(deployment STREQUAL "")
            string(REGEX MATCH "cmd LC_VERSION_MIN_MACOSX[\r\n \t]+cmdsize[^\n]+[\r\n \t]+version[ \t]+([0-9]+\\.[0-9.]+)" deployment "${audit_output}")
        endif()
        if(deployment STREQUAL "")
            message(FATAL_ERROR "Missing Mach-O deployment-target evidence for ${tool}")
        endif()
        list(APPEND deployment_versions "${CMAKE_MATCH_1}")
    endforeach()
    list(SORT deployment_versions COMPARE NATURAL ORDER DESCENDING)
    list(GET deployment_versions 0 deployment_floor)
    set(requirements "macOS ${deployment_floor} or later on ${architecture}. Not a universal binary, Developer ID-signed or notarized. Actual Mach-O deployment targets and system library requirements are in DEPENDENCIES.txt. Apple system libraries/libc++ are not bundled.")
endif()
string(APPEND dependencies "\nRequirements: ${requirements}\n\nNo shared runtime DLLs/libraries, compiler, emulator or host SDK are redistributed. Notice files above are copied from the actual configured toolchain, not a historical release cache.\n")
file(WRITE "${package_root}/DEPENDENCIES.txt" "${dependencies}")
