# Use exact linked machine labels, never pre-scheduling IR byte offsets.
function(gsu_profile_map assembly origin code_bytes output)
    file(SIZE "${assembly}" size)
    if(size GREATER 2097152 OR code_bytes LESS 1 OR code_bytes GREATER 65536)
        message(FATAL_ERROR "GSU profile map exceeds resource bounds")
    endif()
    math(EXPR bank_end "(${origin} & 0xFF0000) + 65536")
    math(EXPR end "${origin} + ${code_bytes}")
    if(origin LESS 0 OR end GREATER bank_end OR end GREATER 16777216)
        message(FATAL_ERROR "GSU profile map crosses a program bank")
    endif()
    file(STRINGS "${assembly}" lines)
    set(exports "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^\\.export ([A-Za-z_][A-Za-z0-9_]*)$")
            list(APPEND exports "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    set(code OFF)
    set(pending "")
    set(labels "")
    set(function_name startup)
    foreach(line IN LISTS lines)
        if(line MATCHES "^\\.segment \"CODE\"")
            set(code ON)
        elseif(line MATCHES "^\\.segment")
            set(code OFF)
        elseif(code AND line MATCHES "^([A-Za-z_][A-Za-z0-9_]*):$")
            list(APPEND pending "${CMAKE_MATCH_1}")
        elseif(code AND line MATCHES "; CODE\\+\\$([0-9A-Fa-f]+)$")
            math(EXPR offset "0x${CMAKE_MATCH_1}")
            if(offset GREATER_EQUAL code_bytes)
                message(FATAL_ERROR "Profile label is outside linked CODE")
            endif()
            if(offset EQUAL 0 OR pending)
                set(name entry)
                foreach(label IN LISTS pending)
                    set(name "${label}")
                    if(label IN_LIST exports)
                        set(function_name "${label}")
                        break()
                    endif()
                endforeach()
                math(EXPR address "${origin} + ${offset}")
                list(APPEND labels "${address}|${name}|${function_name}")
                set(pending "")
            endif()
        endif()
    endforeach()
    list(LENGTH labels count)
    if(count LESS 1 OR count GREATER 4096)
        message(FATAL_ERROR "Missing/oversized GSU machine label map")
    endif()
    list(GET labels 0 first)
    string(REPLACE "|" ";" fields "${first}")
    list(GET fields 0 start)
    if(NOT start EQUAL origin)
        message(FATAL_ERROR "GSU profile map does not start at the execution origin")
    endif()
    set(lua "return {origin=${origin}, finish=${end}, regions={\n")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        list(GET labels ${index} record)
        string(REPLACE "|" ";" fields "${record}")
        list(GET fields 0 start)
        list(GET fields 1 name)
        list(GET fields 2 owner)
        if(index LESS last)
            math(EXPR next "${index}+1")
            list(GET labels ${next} record)
            string(REPLACE "|" ";" fields "${record}")
            list(GET fields 0 finish)
        else()
            set(finish ${end})
        endif()
        if(start GREATER_EQUAL finish)
            message(FATAL_ERROR "Unordered GSU profile labels")
        endif()
        string(APPEND lua "{start=${start}, finish=${finish}, name='${name}', owner='${owner}'},\n")
    endforeach()
    string(APPEND lua "}}\n")
    file(WRITE "${output}" "${lua}")
endfunction()

# Independent partitions must account for every observed instruction/clock.
# Region-only profiles deliberately omit category and per-PC timing: assigning
# a whole region's time to one opcode would misrepresent the measurement.
function(gsu_validate_profile profile expected instructions)
    string(JSON measurement GET "${profile}" measurement)
    string(JSON granularity GET "${profile}" granularity)
    string(JSON clocks GET "${profile}" master_clocks)
    string(JSON count GET "${profile}" instructions)
    if(NOT measurement STREQUAL "gsu-entry-interval-profile-v1" OR
       NOT granularity MATCHES "^(opcode|machine_label_regions)$" OR
       NOT clocks MATCHES "^[0-9]+$" OR NOT count MATCHES "^[0-9]+$" OR
       NOT clocks EQUAL expected OR NOT count EQUAL instructions OR
       count LESS 1 OR count GREATER 10000000 OR clocks GREATER 100000000)
        message(FATAL_ERROR "Invalid GSU profile totals/schema")
    endif()
    foreach(partition IN ITEMS categories functions blocks pcs)
        string(JSON entries LENGTH "${profile}" ${partition})
        if((partition STREQUAL "pcs" AND entries GREATER 65536) OR
           (NOT partition STREQUAL "pcs" AND entries GREATER 4096))
            message(FATAL_ERROR "Oversized GSU profile partition")
        endif()
        if(granularity STREQUAL "machine_label_regions" AND partition STREQUAL "categories")
            if(NOT entries EQUAL 0)
                message(FATAL_ERROR "Region-only profile invented opcode timings")
            endif()
            continue()
        endif()
        if(entries LESS 1)
            message(FATAL_ERROR "Missing GSU profile partition")
        endif()
        set(keys "")
        set(instruction_sum 0)
        set(clock_sum 0)
        math(EXPR last "${entries} - 1")
        if(partition STREQUAL "categories")
            set(key_name category)
        elseif(partition STREQUAL "functions")
            set(key_name function)
        elseif(partition STREQUAL "blocks")
            set(key_name region)
        else()
            set(key_name address)
        endif()
        foreach(index RANGE 0 ${last})
            string(JSON key GET "${profile}" ${partition} ${index} ${key_name})
            string(JSON n GET "${profile}" ${partition} ${index} instructions)
            if(NOT key MATCHES "^[A-Za-z0-9_]+$" OR key IN_LIST keys OR
               NOT n MATCHES "^[0-9]+$" OR n LESS 1 OR n GREATER instructions)
                message(FATAL_ERROR "Invalid/duplicate GSU profile record")
            endif()
            list(APPEND keys "${key}")
            math(EXPR instruction_sum "${instruction_sum} + ${n}")
            if(NOT (granularity STREQUAL "machine_label_regions" AND partition STREQUAL "pcs"))
                string(JSON t GET "${profile}" ${partition} ${index} master_clocks)
                if(NOT t MATCHES "^[0-9]+$" OR t GREATER expected)
                    message(FATAL_ERROR "Invalid GSU profile interval")
                endif()
                math(EXPR clock_sum "${clock_sum} + ${t}")
            endif()
        endforeach()
        if(NOT instruction_sum EQUAL instructions OR
           (NOT (granularity STREQUAL "machine_label_regions" AND partition STREQUAL "pcs") AND
            NOT clock_sum EQUAL expected))
            message(FATAL_ERROR "GSU profile partition does not match measured totals")
        endif()
    endforeach()
endfunction()
