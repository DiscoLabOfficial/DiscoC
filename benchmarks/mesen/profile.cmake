include("${CMAKE_CURRENT_LIST_DIR}/../profile.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/build-profile-map.cmake")
set(MESEN_TIMING_METRICS master_clocks_to_stop_entry stop_fetch_master_clocks master_clocks gsu_cycles)
# Timing is deliberately separate from the portable functional opcode model.
set(MESEN_TIMING_PROFILE [=[{"region":"ntsc","gsu_clock_percent":100,"clock_select":1,"cfgr":0,"scmr":57,"scbr":24,"program_memory":"rom","instruction_cache":"cold","pixel_cache":"cold","rom_buffer":"cold","host_execution":"snes_wram","window":"first_opcode_entry_to_stop_completion","initial_pipeline_prefetch_included":false,"stop_completion":"guarded_mesen_fetch_cost_v1","host_copy_dma_display_included":false}]=])

function(mesen_program variable executable)
    if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "" OR "${${variable}}" MATCHES "NOTFOUND$")
        find_program(${variable} NAMES "${executable}")
    endif()
    if(NOT ${variable} OR NOT EXISTS "${${variable}}" OR IS_DIRECTORY "${${variable}}")
        message(FATAL_ERROR "Optional Mesen benchmarks require ${executable}; pass -D${variable}=/absolute/path/to/${executable}")
    endif()
    get_filename_component(path "${${variable}}" ABSOLUTE)
    set(${variable} "${path}" PARENT_SCOPE)
endfunction()

function(mesen_command directory)
    set(wall_timeout 60)
    if(PROFILE_GSU)
        set(wall_timeout 180) # Full emulator-state snapshots slow the observer.
    endif()
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${directory}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT ${wall_timeout})
    if(NOT result STREQUAL "0")
        if(EXISTS "${directory}/timing-error.log")
            file(READ "${directory}/timing-error.log" detail LIMIT 4096)
        endif()
        message(FATAL_ERROR "Mesen benchmark command failed (${result}): ${ARGN}\n${stdout}\n${stderr}\n${detail}")
    endif()
endfunction()

function(mesen_build_host directory)
    mesen_command("${directory}" "${WLA_65816}" ${ARGN}
        -I "${directory}" -i -o host.o "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/host.asm")
    file(WRITE "${directory}/host.link" "[objects]\nhost.o\n")
    mesen_command("${directory}" "${WLALINK}" -r -S host.link host.sfc)
endfunction()

function(mesen_measure directory code_bytes instructions)
    set(emulator_timeout 30)
    if(PROFILE_GSU)
        set(emulator_timeout 150)
    endif()
    set(profile_config "")
    if(PROFILE_GSU)
        if(NOT EXISTS "${directory}/final.s")
            message(FATAL_ERROR "GSU profiling needs the byte-exact linked final.s")
        endif()
        gsu_profile_map("${directory}/final.s" 32768 ${code_bytes} "${directory}/profile-map.lua")
        set(profile_config ", profile_map=[=[${directory}/profile-map.lua]=], profile_script=[=[${CMAKE_CURRENT_FUNCTION_LIST_DIR}/gsu-profile.lua]=]")
    endif()
    file(WRITE "${directory}/timing-config.lua"
        "return {code_bytes=${code_bytes}, instructions=${instructions}${profile_config}}\n")
    # Remove only disposable output evidence for this run, never user settings.
    file(REMOVE "${directory}/timing.json" "${directory}/timing-error.log"
        "${directory}/ram.bin" "${directory}/registers.bin")
    file(REMOVE "${directory}/profile.json")
    mesen_command("${directory}" "${MESEN}" --testrunner --timeout=${emulator_timeout} --doNotSaveSettings
        --snes.region=Ntsc --snes.gsuClockSpeed=100 --snes.enableRandomPowerOnState=false
        --snes.ppuExtraScanlinesBeforeNmi=0 --snes.ppuExtraScanlinesAfterNmi=0
        --snes.disableFrameSkipping=true --debug.scriptWindow.allowIoOsAccess=true
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/measure.lua" "${directory}/host.sfc")
    foreach(artifact IN ITEMS timing.json ram.bin registers.bin)
        if(NOT EXISTS "${directory}/${artifact}")
            message(FATAL_ERROR "Mesen produced no fresh ${artifact}; check Lua API support and testrunner output")
        endif()
    endforeach()
    file(SIZE "${directory}/timing.json" size)
    if(size GREATER 4096)
        message(FATAL_ERROR "Oversized Mesen timing evidence")
    endif()
    file(READ "${directory}/timing.json" evidence)
    if(PROFILE_GSU)
        if(NOT EXISTS "${directory}/profile.json")
            message(FATAL_ERROR "Mesen produced no fresh profile.json")
        endif()
        file(SIZE "${directory}/profile.json" size)
        if(size GREATER 2097152)
            message(FATAL_ERROR "Oversized GSU profile evidence")
        endif()
        file(READ "${directory}/profile.json" profile LIMIT 2097152)
        string(JSON expected GET "${evidence}" master_clocks)
        gsu_validate_profile("${profile}" ${expected} ${instructions})
    endif()
    set(MESEN_EVIDENCE "${evidence}" PARENT_SCOPE)
endfunction()
