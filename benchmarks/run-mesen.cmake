cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/mesen/profile.cmake")
get_filename_component(ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED OUTPUT_DIR)
    set(OUTPUT_DIR "${ROOT_DIR}/build/benchmarks/mesen")
endif()
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
mesen_program(MESEN Mesen)
mesen_program(WLA_65816 wla-65816)
mesen_program(WLALINK wlalink)
if(NOT DEFINED TOOLS_DIR)
    set(TOOLS_DIR "${ROOT_DIR}/build/release/bin")
endif()
get_filename_component(TOOLS_DIR "${TOOLS_DIR}" ABSOLUTE)
foreach(tool IN ITEMS DISCC DISCAS DISCLD)
    if(DEFINED ${tool})
        get_filename_component(${tool} "${${tool}}" ABSOLUTE)
    endif()
endforeach()
if(NOT DEFINED GSU_BENCHMARK_RUNNER)
    if(CMAKE_HOST_WIN32)
        set(GSU_BENCHMARK_RUNNER "${TOOLS_DIR}/disco_gsu_benchmarks.exe")
    else()
        set(GSU_BENCHMARK_RUNNER "${TOOLS_DIR}/disco_gsu_benchmarks")
    endif()
endif()
get_filename_component(GSU_BENCHMARK_RUNNER "${GSU_BENCHMARK_RUNNER}" ABSOLUTE)
if(PROFILE_GSU)
    mesen_command("${OUTPUT_DIR}" "${CMAKE_COMMAND}"
        "-DMESEN=${MESEN}" "-DWLA_65816=${WLA_65816}" "-DWLALINK=${WLALINK}"
        "-DOUTPUT_DIR=${OUTPUT_DIR}/profile-contract" -P "${CMAKE_CURRENT_LIST_DIR}/mesen/test-profile.cmake")
endif()
mesen_command("${OUTPUT_DIR}" "${CMAKE_COMMAND}"
    "-DMESEN=${MESEN}" "-DWLA_65816=${WLA_65816}" "-DWLALINK=${WLALINK}"
    "-DGSU_BENCHMARK_RUNNER=${GSU_BENCHMARK_RUNNER}" "-DOUTPUT_DIR=${OUTPUT_DIR}/calibration"
    -P "${CMAKE_CURRENT_LIST_DIR}/mesen/test-calibration.cmake")
set(arguments "-DTOOLS_DIR=${TOOLS_DIR}" "-DGSU_BENCHMARK_RUNNER=${GSU_BENCHMARK_RUNNER}")
foreach(variable IN ITEMS DISCC DISCAS DISCLD CASE TOOLCHAIN_LABEL TOOLCHAIN_REVISION OPTIMIZATION)
    if(DEFINED ${variable})
        list(APPEND arguments "-D${variable}=${${variable}}")
    endif()
endforeach()
mesen_command("${OUTPUT_DIR}" "${CMAKE_COMMAND}" ${arguments}
    "-DOUTPUT_DIR=${OUTPUT_DIR}/opcodes" -P "${CMAKE_CURRENT_LIST_DIR}/run.cmake")
file(READ "${OUTPUT_DIR}/opcodes/report.json" opcode_report)
string(JSON report SET "${opcode_report}" measurement "\"gsu-mesen-v1\"")
string(JSON report SET "${report}" timing_profile "${MESEN_TIMING_PROFILE}")
set(identity "")
foreach(source IN ITEMS mesen/profile.cmake mesen/host.asm mesen/measure.lua
                        mesen/test-calibration.cmake mesen/test-no-stop.cmake run-mesen.cmake
                        mesen/gsu-profile.lua mesen/build-profile-map.cmake mesen/test-profile.cmake mesen/test-profile.lua)
    benchmark_text_hash("${CMAKE_CURRENT_LIST_DIR}/${source}" hash)
    string(APPEND identity "${source}:${hash}\n")
endforeach()
string(SHA256 hash "${identity}")
string(JSON report SET "${report}" harness_sha256 "\"${hash}\"")
if(PROFILE_GSU)
    string(JSON report SET "${report}" profiler "\"gsu-entry-interval-profile-v1\"")
endif()
foreach(tool IN ITEMS MESEN WLA_65816 WLALINK)
    file(SHA256 "${${tool}}" hash)
    string(TOLOWER "${tool}" name)
    string(JSON report SET "${report}" "${name}_sha256" "\"${hash}\"")
endforeach()
set(metrics ${BENCHMARK_METRICS} ${MESEN_TIMING_METRICS})
set(csv "name,result")
foreach(metric IN LISTS metrics)
    string(APPEND csv ",${metric}")
endforeach()
string(APPEND csv ",payload_sha256\n")
string(JSON count LENGTH "${report}" cases)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    string(JSON name GET "${report}" cases ${index} name)
    string(JSON code GET "${report}" cases ${index} code_bytes)
    string(JSON instructions GET "${report}" cases ${index} instructions_executed)
    set(directory "${OUTPUT_DIR}/opcodes/${name}")
    mesen_command("${directory}" "${GSU_BENCHMARK_RUNNER}" --mesen-fixture "${name}" seed.bin)
    mesen_build_host("${directory}")
    mesen_measure("${directory}" ${code} ${instructions})
    if(PROFILE_GSU)
        file(READ "${directory}/profile.json" profile LIMIT 2097152)
        string(JSON report SET "${report}" cases ${index} profile "${profile}")
    endif()
    mesen_command("${directory}" "${GSU_BENCHMARK_RUNNER}" --verify-mesen "${name}" ram.bin registers.bin)
    foreach(metric IN LISTS MESEN_TIMING_METRICS)
        string(JSON type TYPE "${MESEN_EVIDENCE}" "${metric}")
        string(JSON value GET "${MESEN_EVIDENCE}" "${metric}")
        if(NOT type STREQUAL "NUMBER" OR NOT value MATCHES "^[0-9]+$" OR value GREATER 100000000)
            message(FATAL_ERROR "Invalid Mesen timing evidence: ${metric}")
        endif()
        string(JSON report SET "${report}" cases ${index} "${metric}" "${value}")
    endforeach()
    string(JSON observed_instructions GET "${MESEN_EVIDENCE}" instructions_executed)
    if(NOT observed_instructions EQUAL instructions)
        message(FATAL_ERROR "Mesen/opcode-model execution counts differ")
    endif()
    string(JSON result GET "${report}" cases ${index} result)
    string(APPEND csv "${name},${result}")
    foreach(metric IN LISTS metrics)
        string(JSON value GET "${report}" cases ${index} "${metric}")
        string(APPEND csv ",${value}")
    endforeach()
    string(JSON payload_hash GET "${report}" cases ${index} payload_sha256)
    string(APPEND csv ",${payload_hash}\n")
    string(JSON clocks GET "${report}" cases ${index} master_clocks)
    message(STATUS "Mesen ${name}: ${code} code bytes, ${clocks} emulated master clocks/fast GSU cycles; result/memory/stack verified")
endforeach()

# Validate the timing contract before replacing any completed timing report.
file(WRITE "${OUTPUT_DIR}/report.json.tmp" "${report}\n")
mesen_command("${OUTPUT_DIR}" "${CMAKE_COMMAND}"
    "-DBASELINE=${OUTPUT_DIR}/report.json.tmp" "-DCURRENT=${OUTPUT_DIR}/report.json.tmp"
    "-DOUTPUT_DIR=${OUTPUT_DIR}/contract-check" -P "${CMAKE_CURRENT_LIST_DIR}/compare.cmake")
file(WRITE "${OUTPUT_DIR}/report.csv.tmp" "${csv}")
file(RENAME "${OUTPUT_DIR}/report.json.tmp" "${OUTPUT_DIR}/report.json")
file(RENAME "${OUTPUT_DIR}/report.csv.tmp" "${OUTPUT_DIR}/report.csv")
message(STATUS "Mesen timing reports: ${OUTPUT_DIR}/report.json and report.csv")
if(DEFINED BASELINE)
    set(CURRENT "${OUTPUT_DIR}/report.json")
    include("${CMAKE_CURRENT_LIST_DIR}/compare.cmake")
endif()
