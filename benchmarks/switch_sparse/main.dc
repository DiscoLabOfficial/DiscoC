word classify(word key) {
    word result = 99;
    switch (key) {
        case 1: result = 1; break;
        case 17: result = 2; break;
        case 257: result = 3; break;
        case 1024: result = 4; break;
        case 2048: result = 5; break;
        case 8192: result = 6; break;
        case 16384: result = 7; break;
        case 30000: result = 8; break;
        default: break;
    }
    return result;
}

word main() {
    word result = 0;
    for (word i = 0; i < 9; i++) result += classify(((word*)0x0400)[i]);
    *(volatile word*)0x0120 = result;
    return result;
}
