cmake_minimum_required(VERSION 3.20)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT DEFINED TOOLS_DIR)
    set(TOOLS_DIR "${ROOT}/build/release/bin")
endif()
if(NOT DEFINED OUTPUT_DIR)
    set(OUTPUT_DIR "${ROOT}/build/benchmarks/value-optimizations")
endif()
if(NOT DEFINED TOOLCHAIN_LABEL)
    set(TOOLCHAIN_LABEL "working-tree")
endif()
if(NOT TOOLCHAIN_LABEL MATCHES "^[A-Za-z0-9_.-]+$")
    message(FATAL_ERROR "TOOLCHAIN_LABEL must contain only letters, numbers, dots, underscores or hyphens")
endif()
if(CMAKE_HOST_WIN32)
    set(suffix .exe)
endif()
if(NOT DEFINED RUNNER)
    set(RUNNER "${ROOT}/build/release/bin/disco_gsu_execution_tests${suffix}")
endif()
function(checked output)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 60)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Value benchmark failed: ${ARGN}\n${stdout}\n${stderr}")
    endif()
    set(${output} "${stdout}" PARENT_SCOPE)
endfunction()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(SHA256 "${TOOLS_DIR}/discc${suffix}" compiler_hash)
file(SHA256 "${ROOT}/tests/GSUInstructionModel.hpp" model_hash)
file(SHA256 "${RUNNER}" runner_hash)
set(report "{\"measurement\":\"gsu-value-opcodes-v1\",\"optimization\":2,\"toolchain_label\":\"${TOOLCHAIN_LABEL}\",\"discc_sha256\":\"${compiler_hash}\",\"model_sha256\":\"${model_hash}\",\"runner_sha256\":\"${runner_hash}\",\"seed\":46,\"factor\":7,\"origin\":32768,\"stack_pointer\":8192,\"cases\":[]}")
set(index 0)
foreach(case IN ITEMS gvn recurrence scalar_cells known_bits hot_lifetimes)
    set(path "${OUTPUT_DIR}/${case}")
    set(source "${CMAKE_CURRENT_LIST_DIR}/${case}.dc")
    file(MAKE_DIRECTORY "${path}")
    checked(unused "${TOOLS_DIR}/discc${suffix}" -O2 "${source}" -o "${path}/main.o")
    set(link --origin 0x008000 --init-runtime --ram-bank 0 --stack-pointer 0x2000)
    checked(unused "${TOOLS_DIR}/discld${suffix}" "${path}/main.o" ${link} --emit-asm "${path}/final.s" -o "${path}/main.bin")
    checked(unused "${TOOLS_DIR}/discc${suffix}" -O2 "${source}" --emit-asm -o "${path}/source.s")
    checked(unused "${TOOLS_DIR}/discas${suffix}" "${path}/source.s" -o "${path}/asm.o")
    checked(unused "${TOOLS_DIR}/discld${suffix}" "${path}/asm.o" ${link} -o "${path}/asm.bin")
    checked(unused "${TOOLS_DIR}/discas${suffix}" "${path}/final.s" -o "${path}/final.o")
    checked(unused "${TOOLS_DIR}/discld${suffix}" "${path}/final.o" -o "${path}/final.bin")
    file(SHA256 "${path}/main.bin" payload_hash)
    foreach(alternative IN ITEMS asm final)
        file(SHA256 "${path}/${alternative}.bin" actual)
        if(NOT actual STREQUAL payload_hash)
            message(FATAL_ERROR "${case}: assembly round trip changed bytes")
        endif()
    endforeach()
    if(case STREQUAL "gvn")
        set(expected 322)
    elseif(case STREQUAL "recurrence")
        set(expected 14448)
    elseif(case STREQUAL "scalar_cells")
        set(expected 236)
    elseif(case STREQUAL "known_bits")
        set(expected 302)
    else()
        set(expected 558)
    endif()
    checked(metrics "${RUNNER}" "${path}/main.bin" 0x008000 --metrics --ram-byte 0x700100 46 --ram-byte 0x700102 7
        --word 0x700120 ${expected} --register 0 42 --register 6 0 --register 10 0x1ffc --reads 0x700100 1)
    file(SHA256 "${source}" source_hash)
    string(JSON metrics SET "${metrics}" name "\"${case}\"")
    string(JSON metrics SET "${metrics}" source_sha256 "\"${source_hash}\"")
    string(JSON metrics SET "${metrics}" payload_sha256 "\"${payload_hash}\"")
    string(JSON report SET "${report}" cases ${index} "${metrics}")
    string(JSON instructions GET "${metrics}" instructions)
    string(JSON bytes GET "${metrics}" payload_bytes)
    message(STATUS "${case}: ${bytes} payload bytes, ${instructions} executed opcodes; result and bytes verified")
    math(EXPR index "${index}+1")
endforeach()
file(WRITE "${OUTPUT_DIR}/report.json" "${report}\n")
