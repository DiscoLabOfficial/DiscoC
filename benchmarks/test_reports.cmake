cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/profile.cmake")
if(NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "OUTPUT_DIR is required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(SHA256 identity "benchmark-report-unit-test")
set(sample "{\"name\":\"memcpy\",\"result\":128,\"payload_sha256\":\"${identity}\"}")
foreach(metric IN LISTS BENCHMARK_METRICS)
    string(JSON sample SET "${sample}" "${metric}" 0)
endforeach()
string(JSON sample SET "${sample}" code_bytes 100)
string(JSON sample SET "${sample}" payload_bytes 100)
string(JSON sample SET "${sample}" instructions_executed 1000)
set(reference "{\"schema\":1,\"suite_version\":1,\"measurement\":\"gsu-opcode-v1\",\"workload_sha256\":\"${identity}\",\"model_sha256\":\"${identity}\",\"profile\":${BENCHMARK_PROFILE},\"cases\":[${sample}]}")
file(WRITE "${OUTPUT_DIR}/baseline.json" "${reference}")

function(check_report name current success pattern)
    file(WRITE "${OUTPUT_DIR}/${name}.json" "${current}")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DBASELINE=${OUTPUT_DIR}/baseline.json" "-DCURRENT=${OUTPUT_DIR}/${name}.json"
        "-DOUTPUT_DIR=${OUTPUT_DIR}/${name}" -DFAIL_ON_REGRESSION=ON ${ARGN}
        -P "${CMAKE_CURRENT_LIST_DIR}/compare.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 60)
    if(success AND NOT result STREQUAL "0")
        message(FATAL_ERROR "Valid benchmark comparison failed: ${name}\n${stdout}\n${stderr}")
    elseif(NOT success AND result STREQUAL "0")
        message(FATAL_ERROR "Invalid benchmark comparison succeeded: ${name}")
    endif()
    if(NOT "${stdout}\n${stderr}" MATCHES "${pattern}")
        message(FATAL_ERROR "Missing comparison diagnostic: ${name}: ${pattern}\n${stdout}\n${stderr}")
    endif()
endfunction()

check_report(equal "${reference}" TRUE "delta 0")
string(JSON current SET "${reference}" cases 0 code_bytes 90)
string(JSON current SET "${current}" cases 0 payload_bytes 90)
string(JSON current SET "${current}" cases 0 instructions_executed 900)
check_report(improvement "${current}" TRUE "delta -100")
file(READ "${OUTPUT_DIR}/improvement/comparison.csv" csv)
if(NOT csv MATCHES "memcpy,code_bytes,100,90,-10" OR NOT csv MATCHES "memcpy,instructions_executed,1000,900,-100")
    message(FATAL_ERROR "Comparison CSV lost signed deltas")
endif()
string(JSON current SET "${reference}" cases 0 code_bytes 101)
string(JSON current SET "${current}" cases 0 payload_bytes 101)
check_report(regression "${current}" FALSE "Benchmark regressions")
check_report(tradeoff "${current}" TRUE "Comparison:" "-DREGRESSION_METRICS=instructions_executed")
string(JSON current SET "${reference}" model_sha256 "\"different\"")
check_report(model_change "${current}" FALSE "model_sha256 differs")
string(JSON current SET "${reference}" workload_sha256 "\"different\"")
check_report(workload_change "${current}" FALSE "workload_sha256 differs")
string(JSON current SET "${reference}" profile ram_bank 1)
check_report(profile_change "${current}" FALSE "profile differs")
string(JSON current SET "${reference}" cases "[]")
check_report(missing_cases "${current}" FALSE "case sets differ")
string(JSON current SET "${reference}" cases 0 result 129)
check_report(wrong_result "${current}" FALSE "results differ")
string(JSON current SET "${reference}" cases 0 name "\"arithmetic\"")
check_report(wrong_case "${current}" FALSE "names/order")
string(JSON current SET "${reference}" cases 0 stores -1)
check_report(negative_count "${current}" FALSE "Invalid numeric")
string(JSON current SET "${reference}" cases 0 stores "\"0\"")
check_report(string_count "${current}" FALSE "Invalid numeric")
string(JSON current SET "${reference}" cases 0 stores 100000001)
check_report(oversized_count "${current}" FALSE "measurement bounds")
foreach(field IN ITEMS payload_bytes loads stack_accesses stack_loads stack_stores getc taken_branches)
    string(JSON current SET "${reference}" cases 0 "${field}" 1)
    check_report(inconsistent_${field} "${current}" FALSE "Inconsistent benchmark")
endforeach()
string(JSON current SET "${reference}" cases 0 instructions_executed 10000001)
check_report(instruction_limit "${current}" FALSE "Inconsistent benchmark")
string(JSON current SET "${reference}" cases 0 plot 1001)
check_report(event_limit "${current}" FALSE "event count exceeds")
string(JSON current SET "${reference}" cases 0 result 65536)
check_report(result_limit "${current}" FALSE "Inconsistent benchmark")
check_report(malformed "{" FALSE "JSON")
string(REPEAT " " 1048577 oversized)
check_report(oversized_report "${oversized}" FALSE "exceeds 1 MiB")

