    check_report(mesen_string_${field} "${current}" FALSE "Invalid numeric")
    string(JSON current SET "${timing_reference}" cases 0 "${field}" 100000001)
    check_report(mesen_huge_${field} "${current}" FALSE "measurement bounds")
endforeach()
foreach(field IN ITEMS master_clocks_to_stop_entry master_clocks gsu_cycles)
    string(JSON current SET "${timing_reference}" cases 0 "${field}" 1234)
    check_report(mesen_inconsistent_${field} "${current}" FALSE "Inconsistent Mesen")
endforeach()
string(JSON current SET "${timing_reference}" cases 0 stop_fetch_master_clocks 6)
check_report(mesen_unknown_stop_cost "${current}" FALSE "Inconsistent Mesen")
string(JSON current SET "${timing_reference}" cases 0 code_bytes 24576)
string(JSON current SET "${current}" cases 0 payload_bytes 24576)
check_report(mesen_payload_host_overlap "${current}" FALSE "Inconsistent Mesen")
