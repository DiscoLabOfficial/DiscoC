cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/../mesen/profile.cmake")
get_filename_component(ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT DEFINED TOOLS_DIR)
    set(TOOLS_DIR "${ROOT_DIR}/build/release/bin")
endif()
if(NOT DEFINED OUTPUT_DIR)
    set(OUTPUT_DIR "${ROOT_DIR}/build/benchmarks/size-pool")
endif()
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
set(suffix "")
if(CMAKE_HOST_WIN32)
    set(suffix ".exe")
endif()
foreach(tool IN ITEMS DISCC DISCAS DISCLD GSU_BENCHMARK_RUNNER)
    if(NOT DEFINED ${tool})
        string(TOLOWER "${tool}" executable)
        if(tool STREQUAL "GSU_BENCHMARK_RUNNER")
            set(executable disco_gsu_benchmarks)
        endif()
        set(${tool} "${TOOLS_DIR}/${executable}${suffix}")
    endif()
    get_filename_component(${tool} "${${tool}}" ABSOLUTE)
    if(NOT EXISTS "${${tool}}" OR IS_DIRECTORY "${${tool}}")
        message(FATAL_ERROR "Missing size-pool tool ${tool}")
    endif()
endforeach()
mesen_program(MESEN Mesen)
mesen_program(WLA_65816 wla-65816)
mesen_program(WLALINK wlalink)
foreach(level IN ITEMS 2 s)
    set(directory "${OUTPUT_DIR}/O${level}")
    file(MAKE_DIRECTORY "${directory}")
    mesen_command("${directory}" "${DISCC}" "-O${level}"
        --origin 0x008000 "${CMAKE_CURRENT_LIST_DIR}/division_pool.dc" -o main.o)
    if(level STREQUAL "s")
        file(READ "${directory}/main.o" object_bytes HEX)
        foreach(kind IN ITEMS s u)
            string(HEX "__disco_os_divmod_${kind}" marker)
            string(FIND "${object_bytes}" "${marker}" position)
            if(position EQUAL -1)
                message(FATAL_ERROR "Size-pool test did not select the ${kind} private kernel")
            endif()
        endforeach()
    endif()
    mesen_command("${directory}" "${DISCLD}" main.o --origin 0x008000 --init-runtime
        --ram-bank 0 --stack-pointer 0xFFFE --emit-asm final.s -o payload.bin)
    mesen_command("${directory}" "${DISCAS}" final.s -o linked.o)
    mesen_command("${directory}" "${DISCLD}" linked.o -o reconstructed.bin)
    file(SHA256 "${directory}/payload.bin" expected)
    file(SHA256 "${directory}/reconstructed.bin" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Size-pool final assembly did not reconstruct exact bytes")
    endif()
    # Reuse only the established seed-3/result-2019 snapshot contract, not the
    # function-call workload itself. The source and reports identify this case.
    execute_process(COMMAND "${GSU_BENCHMARK_RUNNER}" function_call payload.bin linked.o
        WORKING_DIRECTORY "${directory}" RESULT_VARIABLE result OUTPUT_VARIABLE metrics ERROR_VARIABLE error TIMEOUT 60)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Size-pool functional oracle failed: ${error}")
    endif()
    string(JSON bytes GET "${metrics}" code_bytes)
    string(JSON instructions GET "${metrics}" instructions_executed)
    mesen_command("${directory}" "${GSU_BENCHMARK_RUNNER}" --mesen-fixture function_call seed.bin)
    mesen_build_host("${directory}")
    mesen_measure("${directory}" ${bytes} ${instructions})
    mesen_command("${directory}" "${GSU_BENCHMARK_RUNNER}" --verify-mesen function_call ram.bin registers.bin)
    string(JSON clocks GET "${MESEN_EVIDENCE}" gsu_cycles)
    string(JSON metrics SET "${metrics}" name "\"division_pool\"")
    string(JSON metrics SET "${metrics}" gsu_cycles "${clocks}")
    string(JSON metrics SET "${metrics}" payload_sha256 "\"${expected}\"")
    file(SHA256 "${DISCC}" tool_hash)
    string(JSON metrics SET "${metrics}" discc_sha256 "\"${tool_hash}\"")
    benchmark_text_hash("${CMAKE_CURRENT_LIST_DIR}/division_pool.dc" source_hash)
    string(JSON metrics SET "${metrics}" source_sha256 "\"${source_hash}\"")
    string(JSON metrics SET "${metrics}" measurement "\"gsu-mesen-size-pool-v1\"")
    file(WRITE "${directory}/report.json" "${metrics}\n")
    set(bytes_${level} ${bytes})
    message(STATUS "Division pool O${level}: ${bytes} bytes, ${clocks} emulated cycles; result 2019, memory/stack and bytes verified")
endforeach()
if(NOT bytes_s LESS bytes_2)
    message(FATAL_ERROR "Size-pool kernels did not amortize caller preservation")
endif()
