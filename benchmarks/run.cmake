cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/profile.cmake")
get_filename_component(ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

if(NOT DEFINED TOOLS_DIR)
    set(TOOLS_DIR "${ROOT_DIR}/build/release/bin")
endif()
if(CMAKE_HOST_WIN32)
    set(suffix ".exe")
else()
    set(suffix "")
endif()
foreach(tool IN ITEMS DISCC DISCAS DISCLD GSU_BENCHMARK_RUNNER)
    if(NOT DEFINED ${tool})
        if(tool STREQUAL "GSU_BENCHMARK_RUNNER")
            set(${tool} "${TOOLS_DIR}/disco_gsu_benchmarks${suffix}")
        else()
            string(TOLOWER "${tool}" executable)
            set(${tool} "${TOOLS_DIR}/${executable}${suffix}")
        endif()
    endif()
    if(NOT EXISTS "${${tool}}" OR IS_DIRECTORY "${${tool}}")
        message(FATAL_ERROR "Missing ${tool}: ${${tool}}; build the native tools/benchmark runner first")
    endif()
endforeach()
if(NOT DEFINED OUTPUT_DIR)
    set(OUTPUT_DIR "${ROOT_DIR}/build/benchmarks/current")
endif()
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
if(NOT DEFINED TOOLCHAIN_LABEL)
    set(TOOLCHAIN_LABEL "working-tree")
endif()
if(NOT TOOLCHAIN_LABEL MATCHES "^[A-Za-z0-9_.-]+$")
    message(FATAL_ERROR "TOOLCHAIN_LABEL must contain only letters, numbers, dots, underscores or hyphens")
endif()
if(NOT DEFINED TOOLCHAIN_REVISION)
    set(TOOLCHAIN_REVISION "unknown")
endif()
if(NOT TOOLCHAIN_REVISION STREQUAL "unknown")
    string(LENGTH "${TOOLCHAIN_REVISION}" revision_length)
    if(NOT revision_length EQUAL 40 OR NOT TOOLCHAIN_REVISION MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "TOOLCHAIN_REVISION must be a full Git commit hash or unknown")
    endif()
endif()

function(benchmark_command output)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 60)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Benchmark command failed (${result}): ${ARGN}\n${stdout}\n${stderr}")
    endif()
    set(${output} "${stdout}" PARENT_SCOPE)
endfunction()

# Normalize line endings so the same suite/model is comparable across hosts.
set(workload_identity "")
foreach(name IN LISTS BENCHMARK_NAMES)
    benchmark_sources("${name}" sources)
    foreach(source IN LISTS sources)
        benchmark_text_hash("${CMAKE_CURRENT_LIST_DIR}/${source}" digest)
        string(APPEND workload_identity "${source}:${digest}\n")
    endforeach()
endforeach()
string(SHA256 workload_hash "${workload_identity}")
set(model_identity "")
foreach(source IN ITEMS tests/GSUInstructionModel.hpp tests/GSUGraphicsModel.hpp benchmarks/GSUBenchmarkRunner.cpp)
    benchmark_text_hash("${ROOT_DIR}/${source}" digest)
    string(APPEND model_identity "${source}:${digest}\n")
endforeach()
string(SHA256 model_hash "${model_identity}")
foreach(tool IN ITEMS DISCC DISCAS DISCLD GSU_BENCHMARK_RUNNER)
    file(SHA256 "${${tool}}" ${tool}_HASH)
endforeach()

set(cases "[]")
set(csv "name,result")
foreach(metric IN LISTS BENCHMARK_METRICS)
    string(APPEND csv ",${metric}")
endforeach()
string(APPEND csv ",payload_sha256\n")
set(selected "${BENCHMARK_NAMES}")
if(DEFINED CASE)
    if(NOT CASE IN_LIST BENCHMARK_NAMES)
        message(FATAL_ERROR "Unknown benchmark CASE: ${CASE}")
    endif()
    set(selected "${CASE}")
endif()
set(case_index 0)
set(compile_optimization "")
set(optimization 0)
if(DEFINED OPTIMIZATION)
    if(NOT OPTIMIZATION MATCHES "^[012s]$")
        message(FATAL_ERROR "OPTIMIZATION must be 0, 1, 2 or s")
    endif()
    set(optimization "${OPTIMIZATION}")
    set(compile_optimization "-O${OPTIMIZATION}")
endif()
foreach(name IN LISTS selected)
    set(directory "${OUTPUT_DIR}/${name}")
    file(MAKE_DIRECTORY "${directory}")
    benchmark_sources("${name}" sources)
    set(objects "")
    foreach(source IN LISTS sources)
        get_filename_component(stem "${source}" NAME_WE)
        set(object "${directory}/${stem}.o")
        benchmark_command(unused "${DISCC}" ${compile_optimization} --target gsu --memory-mapping lorom --execution-memory rom
            --origin 0x008000 "${CMAKE_CURRENT_LIST_DIR}/${source}" -o "${object}")
        list(APPEND objects "${object}")
    endforeach()
    benchmark_command(unused "${DISCLD}" ${objects} --origin 0x008000 --init-runtime
        --ram-bank 0 --ram-origin 0x0400 --stack-pointer 0xFFFE --entry main
        --emit-asm "${directory}/final.s" -o "${directory}/payload.bin")
    benchmark_command(unused "${DISCAS}" "${directory}/final.s" -o "${directory}/linked.o")
    benchmark_command(measurement "${GSU_BENCHMARK_RUNNER}" "${name}" "${directory}/payload.bin" "${directory}/linked.o")
    string(JSON measured_name GET "${measurement}" name)
    if(NOT measured_name STREQUAL name)
        message(FATAL_ERROR "Runner reported a different benchmark name")
    endif()
    file(SHA256 "${directory}/payload.bin" payload_hash)
    string(JSON measurement SET "${measurement}" payload_sha256 "\"${payload_hash}\"")
    string(JSON cases SET "${cases}" ${case_index} "${measurement}")
    math(EXPR case_index "${case_index} + 1")
    string(JSON result GET "${measurement}" result)
    string(APPEND csv "${name},${result}")
    foreach(metric IN LISTS BENCHMARK_METRICS)
        string(JSON value GET "${measurement}" "${metric}")
        string(APPEND csv ",${value}")
    endforeach()
    string(APPEND csv ",${payload_hash}\n")
    string(JSON code GET "${measurement}" code_bytes)
    string(JSON instructions GET "${measurement}" instructions_executed)
    message(STATUS "${name}: ${code} code bytes, ${instructions} executed opcodes; result verified")
endforeach()

set(report "{\"schema\":1,\"suite_version\":1,\"measurement\":\"gsu-opcode-v1\",\"workload_sha256\":\"${workload_hash}\",\"model_sha256\":\"${model_hash}\",\"profile\":${BENCHMARK_PROFILE},\"toolchain\":{\"label\":\"${TOOLCHAIN_LABEL}\",\"revision\":\"${TOOLCHAIN_REVISION}\",\"discc_sha256\":\"${DISCC_HASH}\",\"discas_sha256\":\"${DISCAS_HASH}\",\"discld_sha256\":\"${DISCLD_HASH}\",\"runner_sha256\":\"${GSU_BENCHMARK_RUNNER_HASH}\"},\"cases\":${cases}}")
string(JSON report SET "${report}" schema 1)
if(optimization STREQUAL "s")
    string(JSON report SET "${report}" toolchain optimization "\"s\"")
else()
    string(JSON report SET "${report}" toolchain optimization "${optimization}")
endif()
# Reports are only replaced after every selected workload passes correctness.
file(WRITE "${OUTPUT_DIR}/report.csv.tmp" "${csv}")
file(WRITE "${OUTPUT_DIR}/report.json.tmp" "${report}\n")
file(RENAME "${OUTPUT_DIR}/report.csv.tmp" "${OUTPUT_DIR}/report.csv")
file(RENAME "${OUTPUT_DIR}/report.json.tmp" "${OUTPUT_DIR}/report.json")
message(STATUS "Benchmark reports: ${OUTPUT_DIR}/report.json and report.csv")
if(DEFINED BASELINE)
    set(CURRENT "${OUTPUT_DIR}/report.json")
    include("${CMAKE_CURRENT_LIST_DIR}/compare.cmake")
endif()
