cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/mesen/build-profile-map.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(assembly "${OUTPUT_DIR}/final.s")
set(profile [=[{"measurement":"gsu-entry-interval-profile-v1","granularity":"opcode","master_clocks":10,"instructions":2,"categories":[{"category":"nop","instructions":1,"master_clocks":5},{"category":"stop","instructions":1,"master_clocks":5}],"functions":[{"function":"main","instructions":2,"master_clocks":10}],"blocks":[{"region":1,"instructions":2,"master_clocks":10}],"pcs":[{"address":32768,"instructions":1,"master_clocks":5},{"address":32769,"instructions":1,"master_clocks":5}]}]=])
if(DEFINED CASE)
    if(CASE STREQUAL "no_code")
        file(WRITE "${assembly}" ".segment \"DATA\"\nmain:\n.db $00\n")
    elseif(CASE STREQUAL "entry_gap")
        file(WRITE "${assembly}" ".segment \"CODE\"\nmain:\n  STOP ; CODE+$0001\n")
    elseif(CASE STREQUAL "unordered")
        file(WRITE "${assembly}" ".segment \"CODE\"\na:\n  NOP ; CODE+$0000\nb:\n  NOP ; CODE+$0000\n")
    elseif(CASE STREQUAL "outside")
        file(WRITE "${assembly}" ".segment \"CODE\"\n  NOP ; CODE+$0000\na:\n  STOP ; CODE+$000A\n")
    elseif(CASE STREQUAL "bank_crossing")
        file(WRITE "${assembly}" ".segment \"CODE\"\n  STOP ; CODE+$0000\n")
        gsu_profile_map("${assembly}" 65535 2 "${OUTPUT_DIR}/map.lua")
        message(FATAL_ERROR "Cross-bank map unexpectedly accepted")
    elseif(CASE STREQUAL "missing_partition")
        string(JSON profile SET "${profile}" blocks "[]")
        gsu_validate_profile("${profile}" 10 2)
        return()
    elseif(CASE STREQUAL "wrong_sum")
        string(JSON profile SET "${profile}" categories 0 master_clocks 4)
        gsu_validate_profile("${profile}" 10 2)
        return()
    elseif(CASE STREQUAL "duplicate_pc")
        string(JSON profile SET "${profile}" pcs 1 address 32768)
        gsu_validate_profile("${profile}" 10 2)
        return()
    elseif(CASE STREQUAL "invented_timing")
        string(JSON profile SET "${profile}" granularity "\"machine_label_regions\"")
        gsu_validate_profile("${profile}" 10 2)
        return()
    else()
        message(FATAL_ERROR "Unknown profile test case")
    endif()
    gsu_profile_map("${assembly}" 32768 10 "${OUTPUT_DIR}/map.lua")
    return()
endif()
file(WRITE "${assembly}" ".export main\n.export helper\n.export palette\n.segment \"CODE\"\n  NOP ; CODE+$0000\nmain:\nlocal:\n  IWT R0,#1 ; CODE+$0001\nbranch:\n  NOP ; CODE+$0004\nhelper:\n  STOP ; CODE+$0007\n.segment \"DATA\"\npalette:\n.db $00\n")
gsu_profile_map("${assembly}" 32768 9 "${OUTPUT_DIR}/map.lua")
file(READ "${OUTPUT_DIR}/map.lua" map)
foreach(record IN ITEMS
    "{start=32768, finish=32769, name='entry', owner='startup'}"
    "{start=32769, finish=32772, name='main', owner='main'}"
    "{start=32772, finish=32775, name='branch', owner='main'}"
    "{start=32775, finish=32777, name='helper', owner='helper'}")
    string(FIND "${map}" "${record}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Linked machine-label map changed: ${record}")
    endif()
endforeach()
gsu_validate_profile("${profile}" 10 2)
string(JSON profile SET "${profile}" granularity "\"machine_label_regions\"")
string(JSON profile SET "${profile}" categories "[]")
string(JSON profile REMOVE "${profile}" pcs 0 master_clocks)
string(JSON profile REMOVE "${profile}" pcs 1 master_clocks)
gsu_validate_profile("${profile}" 10 2)
foreach(case IN ITEMS no_code entry_gap unordered outside bank_crossing missing_partition wrong_sum duplicate_pc invented_timing)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DOUTPUT_DIR=${OUTPUT_DIR}/${case}" "-DCASE=${case}"
        -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 10)
    if(status STREQUAL "0" OR NOT stderr MATCHES "(GSU|Profile|profile)")
        message(FATAL_ERROR "Profile case ${case} failed for the wrong reason: ${status}\n${stdout}\n${stderr}")
    endif()
endforeach()
message(STATUS "GSU linked-label profile map and partition contracts passed")
