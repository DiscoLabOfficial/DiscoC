cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/profile.cmake")
if(NOT DEFINED BASELINE OR NOT DEFINED CURRENT)
    message(FATAL_ERROR "BASELINE and CURRENT reports are required")
endif()
foreach(input IN ITEMS BASELINE CURRENT)
    file(SIZE "${${input}}" size)
    if(size GREATER 1048576)
        message(FATAL_ERROR "Benchmark report exceeds 1 MiB")
    endif()
    file(READ "${${input}}" ${input}_JSON)
endforeach()
foreach(field IN ITEMS schema suite_version measurement workload_sha256 model_sha256 profile)
    string(JSON before GET "${BASELINE_JSON}" "${field}")
    string(JSON after GET "${CURRENT_JSON}" "${field}")
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Reports are not comparable: ${field} differs; remeasure both toolchains with the same suite/model/profile")
    endif()
endforeach()
string(JSON schema GET "${CURRENT_JSON}" schema)
string(JSON suite_version GET "${CURRENT_JSON}" suite_version)
string(JSON measurement GET "${CURRENT_JSON}" measurement)
if(NOT schema EQUAL 1 OR NOT suite_version EQUAL 1 OR
   NOT measurement MATCHES "^gsu-(opcode|mesen)-v1$")
    message(FATAL_ERROR "Unsupported benchmark report contract")
endif()
set(is_mesen OFF)
if(measurement STREQUAL "gsu-mesen-v1")
    set(is_mesen ON)
    include("${CMAKE_CURRENT_LIST_DIR}/mesen/profile.cmake")
    list(APPEND BENCHMARK_METRICS ${MESEN_TIMING_METRICS})
    foreach(field IN ITEMS timing_profile harness_sha256 mesen_sha256 wla_65816_sha256 wlalink_sha256)
        string(JSON before GET "${BASELINE_JSON}" "${field}")
        string(JSON after GET "${CURRENT_JSON}" "${field}")
        if(NOT before STREQUAL after)
            message(FATAL_ERROR "Reports are not comparable: ${field} differs; remeasure both toolchains")
        endif()
        if(NOT field STREQUAL "timing_profile")
            string(LENGTH "${after}" length)
            if(NOT length EQUAL 64 OR NOT after MATCHES "^[0-9a-f]+$")
                message(FATAL_ERROR "Invalid timing fingerprint: ${field}")
            endif()
        endif()
    endforeach()
    string(JSON expected_timing_profile GET "${MESEN_TIMING_PROFILE}")
    string(JSON timing_profile GET "${CURRENT_JSON}" timing_profile)
    if(NOT timing_profile STREQUAL expected_timing_profile)
        message(FATAL_ERROR "Unsupported Mesen timing profile")
    endif()
endif()
string(JSON expected_profile GET "${BENCHMARK_PROFILE}")
string(JSON profile GET "${CURRENT_JSON}" profile)
if(NOT profile STREQUAL expected_profile)
    message(FATAL_ERROR "Unsupported benchmark execution profile")
endif()
string(JSON before_count LENGTH "${BASELINE_JSON}" cases)
string(JSON after_count LENGTH "${CURRENT_JSON}" cases)
if(NOT before_count EQUAL after_count OR before_count LESS 1 OR before_count GREATER 9)
    message(FATAL_ERROR "Benchmark case sets differ or are empty/oversized")
endif()
if(NOT DEFINED REGRESSION_METRICS)
    if(is_mesen)
        set(REGRESSION_METRICS code_bytes master_clocks)
    else()
        set(REGRESSION_METRICS code_bytes instructions_executed)
    endif()
endif()
foreach(metric IN LISTS REGRESSION_METRICS)
    if(NOT metric IN_LIST BENCHMARK_METRICS)
        message(FATAL_ERROR "Unknown regression metric: ${metric}")
    endif()
endforeach()

function(benchmark_number json index field output)
    string(JSON type TYPE "${json}" cases ${index} "${field}")
    string(JSON value GET "${json}" cases ${index} "${field}")
    string(LENGTH "${value}" length)
    if(NOT type STREQUAL "NUMBER" OR NOT value MATCHES "^[0-9]+$" OR length GREATER 9)
        message(FATAL_ERROR "Invalid numeric benchmark field: ${field}")
    endif()
    if(value GREATER 100000000)
        message(FATAL_ERROR "Benchmark field exceeds the measurement bounds: ${field}")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(benchmark_case json index)
    foreach(metric IN LISTS BENCHMARK_METRICS)
        benchmark_number("${json}" ${index} "${metric}" value_${metric})
    endforeach()
    benchmark_number("${json}" ${index} result value_result)
    math(EXPR payload "${value_code_bytes} + ${value_data_bytes}")
    math(EXPR loads "${value_ram_loads} + ${value_rom_reads}")
    math(EXPR stack "${value_stack_loads} + ${value_stack_stores}")
    if(NOT payload EQUAL value_payload_bytes OR payload GREATER 32768 OR value_code_bytes LESS 1 OR
       NOT loads EQUAL value_loads OR NOT stack EQUAL value_stack_accesses OR
       value_stack_loads GREATER value_ram_loads OR value_stack_stores GREATER value_stores OR
       value_getc GREATER value_rom_reads OR value_taken_branches GREATER value_branches OR
       value_result GREATER 65535 OR value_instructions_executed LESS 1 OR
       value_instructions_executed GREATER 10000000)
        message(FATAL_ERROR "Inconsistent benchmark counters or payload/result bounds")
    endif()
    foreach(metric IN ITEMS loads stores plot color getc rpix branches jumps calls cache)
        if(value_${metric} GREATER value_instructions_executed)
            message(FATAL_ERROR "Benchmark event count exceeds executed instructions: ${metric}")
        endif()
    endforeach()
    if(is_mesen)
        math(EXPR total "${value_master_clocks_to_stop_entry} + ${value_stop_fetch_master_clocks}")
        if(NOT value_stop_fetch_master_clocks MATCHES "^(1|5|81)$" OR
           NOT total EQUAL value_master_clocks OR value_master_clocks LESS 1 OR
           NOT value_gsu_cycles EQUAL value_master_clocks OR value_payload_bytes GREATER_EQUAL 24576)
            message(FATAL_ERROR "Inconsistent Mesen timing counters/profile")
        endif()
    endif()
endfunction()

set(comparison "name,metric,baseline,current,delta\n")
set(regressions "")
set(seen "")
math(EXPR last "${before_count} - 1")
foreach(index RANGE 0 ${last})
    string(JSON name GET "${BASELINE_JSON}" cases ${index} name)
    string(JSON current_name GET "${CURRENT_JSON}" cases ${index} name)
    if(NOT name STREQUAL current_name OR NOT name IN_LIST BENCHMARK_NAMES OR name IN_LIST seen)
        message(FATAL_ERROR "Benchmark case names/order are incompatible or duplicated")
    endif()
    list(APPEND seen "${name}")
    benchmark_case("${BASELINE_JSON}" ${index})
    benchmark_case("${CURRENT_JSON}" ${index})
    benchmark_number("${BASELINE_JSON}" ${index} result before)
    benchmark_number("${CURRENT_JSON}" ${index} result after)
    if(NOT before EQUAL after)
        message(FATAL_ERROR "Benchmark results differ: ${name}")
    endif()
    foreach(metric IN LISTS BENCHMARK_METRICS)
        benchmark_number("${BASELINE_JSON}" ${index} "${metric}" before)
        benchmark_number("${CURRENT_JSON}" ${index} "${metric}" after)
        math(EXPR delta "${after} - ${before}")
        string(APPEND comparison "${name},${metric},${before},${after},${delta}\n")
        if(delta GREATER 0 AND metric IN_LIST REGRESSION_METRICS)
            string(APPEND regressions "${name}/${metric}: +${delta}\n")
        endif()
        if(metric STREQUAL "code_bytes" OR metric STREQUAL "instructions_executed" OR metric STREQUAL "master_clocks")
            message(STATUS "${name}/${metric}: ${before} -> ${after} (delta ${delta})")
        endif()
    endforeach()
endforeach()
if(NOT DEFINED OUTPUT_DIR)
    get_filename_component(OUTPUT_DIR "${CURRENT}" DIRECTORY)
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(WRITE "${OUTPUT_DIR}/comparison.csv.tmp" "${comparison}")
file(RENAME "${OUTPUT_DIR}/comparison.csv.tmp" "${OUTPUT_DIR}/comparison.csv")
if(FAIL_ON_REGRESSION AND NOT regressions STREQUAL "")
    message(FATAL_ERROR "Benchmark regressions in selected metrics:\n${regressions}")
endif()
if(is_mesen)
    message(STATUS "Comparison: ${OUTPUT_DIR}/comparison.csv; cycles are Mesen-model timings, not physical-hardware measurements")
else()
    message(STATUS "Comparison: ${OUTPUT_DIR}/comparison.csv; positive deltas mean more work/bytes, not cycle timings")
endif()
