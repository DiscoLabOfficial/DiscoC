{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "native",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "BUILD_TESTING": "ON" }
    },
    {
      "name": "release",
      "inherits": "native",
      "displayName": "Native Release (Ninja)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "inherits": "native",
      "displayName": "Native Debug (Ninja)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release-mingw",
      "inherits": "release",
      "displayName": "Windows MinGW Release (standalone tools)",
      "generator": "MinGW Makefiles",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++", "DISCO_MINGW_STATIC": "ON" }
    },
    {
      "name": "debug-mingw",
      "inherits": "release-mingw",
      "displayName": "Windows MinGW Debug (standalone tools)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "sanitizers",
      "inherits": "debug",
      "displayName": "Linux ASan + UBSan",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "jobs": 4 },
    { "name": "debug", "configurePreset": "debug", "jobs": 4 },
    { "name": "release-mingw", "configurePreset": "release-mingw", "jobs": 4 },
    { "name": "debug-mingw", "configurePreset": "debug-mingw", "jobs": 4 },
    { "name": "sanitizers", "configurePreset": "sanitizers", "jobs": 4 }
  ],
  "testPresets": [
    {
      "name": "native-tests", "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "jobs": 4 }
    },
    { "name": "release", "inherits": "native-tests", "configurePreset": "release" },
    { "name": "debug", "inherits": "native-tests", "configurePreset": "debug" },
    { "name": "release-mingw", "inherits": "native-tests", "configurePreset": "release-mingw" },
    { "name": "debug-mingw", "inherits": "native-tests", "configurePreset": "debug-mingw" },
    { "name": "sanitizers", "inherits": "native-tests", "configurePreset": "sanitizers" }
  ]
}
