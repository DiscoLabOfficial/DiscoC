@packed struct Pixel { u8 x; u8 y; u8 shade; };
@align(8) struct State { struct Pixel points[2]; word count; };
static_assert(sizeof(struct Pixel) == 3);
static_assert(alignof(struct State) == 8);
static_assert(offsetof(struct State, count) == 6);
void update(struct State* state) { state->points[1].shade = (u8)15; state->count++; }
void main() {
    struct State states[2] = {{{{1, 2, 3}, {4, 5, 6}}, 2}, {}};
    update(&states[0]);
}
