cmake_minimum_required(VERSION 3.20)
foreach(tool IN ITEMS DISCC DISCAS DISCLD DIFFERENTIAL_RUNNER)
    if(NOT DEFINED ${tool} OR NOT EXISTS "${${tool}}" OR IS_DIRECTORY "${${tool}}")
        message(FATAL_ERROR "Differential tests require ${tool}: ${${tool}}")
    endif()
    get_filename_component(${tool} "${${tool}}" ABSOLUTE)
endforeach()
if(NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "Differential tests require OUTPUT_DIR")
endif()
if(NOT DEFINED SEED)
    set(SEED 0xd15c0c32)
endif()
string(LENGTH "${SEED}" seed_length)
if(NOT SEED MATCHES "^(0x[0-9a-fA-F]+|[0-9]+)$" OR seed_length GREATER 10)
    message(FATAL_ERROR "SEED must be a 32-bit unsigned integer")
endif()
math(EXPR SEED "${SEED}")
if(SEED GREATER 4294967295)
    message(FATAL_ERROR "SEED must be a 32-bit unsigned integer")
endif()
set(levels 0 1 2 s)
if(DEFINED OPTIMIZATION)
    if(NOT OPTIMIZATION MATCHES "^[012s]$")
        message(FATAL_ERROR "OPTIMIZATION must be 0, 1, 2 or s")
    endif()
    set(levels "${OPTIMIZATION}")
endif()
set(first 0)
set(last 31)
if(DEFINED CASE_INDEX)
    if(NOT CASE_INDEX MATCHES "^[0-9][0-9]?$" OR CASE_INDEX GREATER 31)
        message(FATAL_ERROR "CASE_INDEX must be 0..31")
    endif()
    set(first "${CASE_INDEX}")
    set(last "${CASE_INDEX}")
endif()
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
# Retain prior failures; a replay gets a new directory, never stale payloads.
string(TIMESTAMP timestamp "%Y%m%d-%H%M%S" UTC)
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef nonce)
set(run_dir "${OUTPUT_DIR}/run-${timestamp}-${nonce}")
file(MAKE_DIRECTORY "${run_dir}")
file(WRITE "${run_dir}/run-info.txt" "seed=${SEED}\nlevels=${levels}\ncases=${first}..${last}\n")
foreach(tool IN ITEMS DISCC DISCAS DISCLD DIFFERENTIAL_RUNNER)
    file(SHA256 "${${tool}}" digest)
    file(APPEND "${run_dir}/run-info.txt" "${tool}=${${tool}}\n${tool}_sha256=${digest}\n")
endforeach()
foreach(source IN ITEMS run_gsu_differential.cmake GSUDifferentialTests.cpp differential/IntegerOracle.hpp
                        GSUInstructionModel.hpp GSUGraphicsModel.hpp)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${source}" digest)
    file(APPEND "${run_dir}/run-info.txt" "${source}_sha256=${digest}\n")
endforeach()

# Bracket-quote argv literally: spaces, backslashes, quotes and '$' in tool
# paths must not change the executable or arguments in a replay.
function(literal output value)
    set(equals "=")
    while(TRUE)
        string(FIND "${value}" "]${equals}]" position)
        if(position EQUAL -1)
            break()
        endif()
        string(APPEND equals "=")
    endwhile()
    set(${output} "[${equals}[${value}]${equals}]" PARENT_SCOPE)
endfunction()

function(fail stage detail)
    file(WRITE "${case_dir}/failure.txt"
        "seed=${SEED}\ncase=${index}\noptimization=O${level}\norigin=${origin}\nram_bank=${bank}\nstage=${stage}\n${detail}\n")
    message(FATAL_ERROR "Differential failure: seed=${SEED}, case=${index}, O${level}, origin=${origin}, RAMBR=${bank}, stage=${stage}. ${detail}\nArtifacts: ${case_dir}\nReplay: cmake -P \"${case_dir}/reproduce.cmake\"")
endfunction()

function(run_step stage)
    # An outer timeout can interrupt execute_process before fail() runs.
    # Leave the active stage beside its partial stdout/stderr and replay.
    file(WRITE "${case_dir}/progress.txt"
        "seed=${SEED}\ncase=${index}\noptimization=O${level}\nstage=${stage}\n")
    file(APPEND "${case_dir}/commands.txt" "${stage}:\n")
    foreach(argument IN LISTS ARGN)
        literal(quoted "${argument}")
        file(APPEND "${case_dir}/commands.txt" "  ${quoted}\n")
    endforeach()
    string(TIMESTAMP started "%s" UTC)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status
        OUTPUT_FILE "${case_dir}/${stage}.stdout.txt"
        ERROR_FILE "${case_dir}/${stage}.stderr.txt" TIMEOUT 45)
    string(TIMESTAMP finished "%s" UTC)
    math(EXPR elapsed "${finished} - ${started}")
    file(APPEND "${case_dir}/timings.txt" "${stage}=${elapsed}s; status=${status}\n")
    if(NOT status STREQUAL "0")
        file(READ "${case_dir}/${stage}.stderr.txt" detail LIMIT 8192)
        fail("${stage}" "Exit=${status}\n${detail}")
    endif()
endfunction()

function(same_payload path)
    file(SHA256 "${case_dir}/direct.bin" expected)
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
        fail("byte-equivalence" "${path} differs from direct.bin: ${expected} / ${actual}")
    endif()
endfunction()

execute_process(COMMAND "${DIFFERENTIAL_RUNNER}" --self-test RESULT_VARIABLE status TIMEOUT 15)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Independent oracle self-test failed (${status})")
endif()
set(executions 0)
foreach(level IN LISTS levels)
    foreach(index RANGE ${first} ${last})
        set(case_dir "${run_dir}/O${level}/case-${index}")
        file(MAKE_DIRECTORY "${case_dir}")
        math(EXPR parity "${index} % 2")
        math(EXPR bank "(${index} / 2) & 1")
        if(parity)
            set(origin 0x706000)
        else()
            set(origin 0x008000)
        endif()
        set(replay "${CMAKE_COMMAND}" "-DDISCC=${DISCC}" "-DDISCAS=${DISCAS}" "-DDISCLD=${DISCLD}"
            "-DDIFFERENTIAL_RUNNER=${DIFFERENTIAL_RUNNER}" "-DOUTPUT_DIR=${run_dir}/replays"
            "-DSEED=${SEED}" "-DCASE_INDEX=${index}" "-DOPTIMIZATION=${level}"
            -P "${CMAKE_CURRENT_LIST_FILE}")
        file(WRITE "${case_dir}/reproduce.cmake" "cmake_minimum_required(VERSION 3.20)\nexecute_process(COMMAND\n")
        foreach(argument IN LISTS replay)
            literal(quoted "${argument}")
            file(APPEND "${case_dir}/reproduce.cmake" "  ${quoted}\n")
        endforeach()
        file(APPEND "${case_dir}/reproduce.cmake"
            "  RESULT_VARIABLE status TIMEOUT 600)\nif(NOT status STREQUAL \"0\")\n  message(FATAL_ERROR \"Differential replay failed: \${status}\")\nendif()\n")
        message(STATUS "GSU differential: seed=${SEED}, case=${index}, O${level}; artifacts=${case_dir}")
        file(WRITE "${case_dir}/commands.txt" "seed=${SEED} case=${index} O${level} origin=${origin} RAMBR=${bank}\n")
        run_step(generate "${DIFFERENTIAL_RUNNER}" --emit "${case_dir}/program.dc" "${case_dir}/expected.txt" "${SEED}" "${index}")
        run_step(compile "${DISCC}" "-O${level}" "${case_dir}/program.dc" -o "${case_dir}/direct.o")
        run_step(link "${DISCLD}" "${case_dir}/direct.o" --origin "${origin}" --init-runtime
            --ram-bank "${bank}" --stack-pointer 0x3000 --emit-asm "${case_dir}/final.s" -o "${case_dir}/direct.bin")
        run_step(check-direct "${DIFFERENTIAL_RUNNER}" --check "${case_dir}/direct.bin" "${SEED}" "${index}")
        run_step(compile-assembly "${DISCC}" "-O${level}" --emit-asm "${case_dir}/program.dc" -o "${case_dir}/compiler.s")
        run_step(assemble "${DISCAS}" "${case_dir}/compiler.s" -o "${case_dir}/assembled.o")
        run_step(link-assembly "${DISCLD}" "${case_dir}/assembled.o" --origin "${origin}" --init-runtime
            --ram-bank "${bank}" --stack-pointer 0x3000 -o "${case_dir}/assembled.bin")
        run_step(check-assembly "${DIFFERENTIAL_RUNNER}" --check "${case_dir}/assembled.bin" "${SEED}" "${index}")
        same_payload("${case_dir}/assembled.bin")
        run_step(assemble-final "${DISCAS}" "${case_dir}/final.s" -o "${case_dir}/final.o")
        run_step(link-final "${DISCLD}" "${case_dir}/final.o" -o "${case_dir}/final.bin")
        same_payload("${case_dir}/final.bin")
        math(EXPR executions "${executions} + 2")
        file(APPEND "${case_dir}/progress.txt" "complete=true\n")
    endforeach()
endforeach()
file(WRITE "${run_dir}/passed.txt" "seed=${SEED}\nexecutions=${executions}\nSTOP/RAM/volatile/return/fault and direct/assembly/final-export equivalence passed\n")
message(STATUS "GSU differential coverage: ${executions} executions passed; seed=${SEED}; artifacts=${run_dir}")
