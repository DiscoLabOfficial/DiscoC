# SPC700 differential cases: the programs and independent expectations shared
# with the GSU runner, compiled for SPC700, linked with --init-runtime and run
# in the SPC700 model. Each case also checks that the --emit-asm path and the
# linked listing reassemble to the same payload as direct compilation.
cmake_minimum_required(VERSION 3.20)
foreach(tool IN ITEMS DISCC DISCAS DISCLD DIFFERENTIAL_RUNNER)
    if(NOT DEFINED ${tool} OR NOT EXISTS "${${tool}}" OR IS_DIRECTORY "${${tool}}")
        message(FATAL_ERROR "SPC700 differential tests require ${tool}: ${${tool}}")
    endif()
endforeach()
if(NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "SPC700 differential tests require OUTPUT_DIR")
endif()
if(NOT DEFINED SEED)
    set(SEED 0xd15c0c32)
endif()
math(EXPR SEED "${SEED}")
if(NOT DEFINED OPTIMIZATION)
    set(OPTIMIZATION 0)
endif()
if(NOT OPTIMIZATION MATCHES "^[012s]$")
    message(FATAL_ERROR "OPTIMIZATION must be 0, 1, 2 or s")
endif()
set(first 0)
set(last 31)
if(DEFINED CASE_INDEX)
    set(first "${CASE_INDEX}")
    set(last "${CASE_INDEX}")
endif()
file(REMOVE_RECURSE "${OUTPUT_DIR}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")

function(step stage)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status
        OUTPUT_FILE "${case_dir}/${stage}.stdout.txt" ERROR_FILE "${case_dir}/${stage}.stderr.txt" TIMEOUT 120)
    if(NOT status STREQUAL "0")
        file(READ "${case_dir}/${stage}.stderr.txt" detail LIMIT 8192)
        message(FATAL_ERROR "SPC700 differential failure: seed=${SEED}, case=${index}, O${OPTIMIZATION}, "
            "stage=${stage}\n${detail}\nArtifacts: ${case_dir}")
    endif()
endfunction()

function(same_payload path)
    file(SHA256 "${case_dir}/direct.bin" expected)
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "SPC700 differential: ${path} differs from direct.bin (case ${index}, O${OPTIMIZATION})")
    endif()
endfunction()

foreach(index RANGE ${first} ${last})
    set(case_dir "${OUTPUT_DIR}/case-${index}")
    file(MAKE_DIRECTORY "${case_dir}")
    step(generate "${DIFFERENTIAL_RUNNER}" --emit "${case_dir}/program.dc" "${case_dir}/expected.txt" "${SEED}" "${index}")
    step(compile "${DISCC}" --target spc700 "-O${OPTIMIZATION}" "${case_dir}/program.dc" -o "${case_dir}/direct.o")
    step(link "${DISCLD}" "${case_dir}/direct.o" --init-runtime --emit-asm "${case_dir}/final.s" -o "${case_dir}/direct.bin")
    step(check-direct "${DIFFERENTIAL_RUNNER}" --check "${case_dir}/direct.bin" "${SEED}" "${index}")
    step(compile-assembly "${DISCC}" --target spc700 "-O${OPTIMIZATION}" --emit-asm "${case_dir}/program.dc"
        -o "${case_dir}/compiler.s")
    step(assemble "${DISCAS}" "${case_dir}/compiler.s" -o "${case_dir}/assembled.o")
    step(link-assembly "${DISCLD}" "${case_dir}/assembled.o" --init-runtime -o "${case_dir}/assembled.bin")
    same_payload("${case_dir}/assembled.bin")
    step(assemble-final "${DISCAS}" "${case_dir}/final.s" -o "${case_dir}/final.o")
    step(link-final "${DISCLD}" "${case_dir}/final.o" -o "${case_dir}/final.bin")
    same_payload("${case_dir}/final.bin")
endforeach()
message(STATUS "SPC700 differential cases ${first}..${last} passed at O${OPTIMIZATION}")
