set(link --origin 0x008000 --init-runtime --ram-bank 0 --stack-pointer 0x2000)
set(pairs "0:0" "0:1" "1:3" "65535:65535" "65534:32768" "32767:3" "32768:65535"
          "32769:32767" "255:257" "128:7" "63:9" "64:11" "65408:13")
set(random 41)
foreach(n RANGE 1 24)
    math(EXPR random "(${random} * 25173 + 13849) & 65535")
    set(seed ${random})
    math(EXPR random "(${random} * 25173 + 13849) & 65535")
    list(APPEND pairs "${seed}:${random}")
endforeach()
foreach(level IN ITEMS 0 1 2 s)
    set(OPTIMIZATION ${level})
    check_round_trip("values-${level}" "${ROOT_DIR}/tests/fixtures/gsu_value_optimization.dc" ${link})
    run_command("${DISCLD}" "${TEST_DIR}/values-${level}.o" ${link} --emit-asm "${TEST_DIR}/values-${level}-final.s" -o "${TEST_DIR}/values-${level}-export.bin")
    run_command("${DISCAS}" "${TEST_DIR}/values-${level}-final.s" -o "${TEST_DIR}/values-${level}-final.o")
    run_command("${DISCLD}" "${TEST_DIR}/values-${level}-final.o" -o "${TEST_DIR}/values-${level}-final.bin")
    file(SHA256 "${TEST_DIR}/values-${level}.bin" expected)
    file(SHA256 "${TEST_DIR}/values-${level}-final.bin" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "O${level} value optimization linked export changed bytes")
    endif()
    foreach(pair IN LISTS pairs)
        string(REPLACE ":" ";" values "${pair}")
        list(GET values 0 seed)
        list(GET values 1 factor)
        math(EXPR inc "(7 * ${seed} + 42) * ${factor} & 65535")
        math(EXPR dec "(7 * ${seed} - 42) * ${factor} & 65535")
        math(EXPR odd "${seed} & 1")
        if(odd)
            set(pointer_result 23)
        else()
            set(pointer_result 17)
        endif()
        math(EXPR cells "(5 * ${seed} + 6 + 15 * ${odd}) & 65535")
        math(EXPR escaped "(2 * ${seed} + 11) & 65535")
        math(EXPR a "(${seed}+1)&65535")
        math(EXPR b "(${seed}+3)&65535")
        math(EXPR c "(${seed}+5)&65535")
        math(EXPR d "(${seed}+7)&65535")
        set(sum 0)
        foreach(i RANGE 0 7)
            math(EXPR sum "(${sum}+${a}*${b}+${c}*${d}+${factor})&65535")
            math(EXPR odd_i "${i}&1")
            if(odd_i)
                set(tick ${a})
            endif()
            math(EXPR a "(${a}+${i})&65535")
            math(EXPR b "(${b}-2)&65535")
            math(EXPR c "${c}^${i}")
            math(EXPR d "(${d}+3)&65535")
        endforeach()
        math(EXPR pressure "(${sum}+${factor}+${a}+${b}+${c}+${d})&65535")
        math(EXPR bounded "${seed}&63")
        math(EXPR next "(${seed}+1)&65535")
        if(seed GREATER_EQUAL 32768)
            math(EXPR signed_seed "${seed}-65536")
        else()
            set(signed_seed ${seed})
        endif()
        if(next GREATER_EQUAL 32768)
            math(EXPR signed_next "${next}-65536")
        else()
            set(signed_next ${next})
        endif()
        if(signed_next GREATER signed_seed)
            set(greater 1)
        else()
            set(greater 0)
        endif()
        math(EXPR byte "${seed}&255")
        if(byte GREATER_EQUAL 128)
            math(EXPR byte "(${byte}-256)&65535")
        endif()
        math(EXPR color "(${seed}&1)+1")
        math(EXPR sl "${seed}&255")
        math(EXPR sh "${seed}>>8")
        math(EXPR fl "${factor}&255")
        math(EXPR fh "${factor}>>8")
        foreach(suffix IN ITEMS "" "-asm")
            run_command("${GSU_RUNNER}" "${TEST_DIR}/values-${level}${suffix}.bin" 0x008000
                --ram-byte 0x700100 ${sl} --ram-byte 0x700101 ${sh} --ram-byte 0x700102 ${fl} --ram-byte 0x700103 ${fh}
                --reads 0x700100 1 --reads 0x700102 1
                --word 0x700120 ${inc} --word 0x700122 ${dec} --word 0x700124 ${cells} --word 0x700126 ${escaped}
                --word 0x700128 ${pressure} --word 0x70012a ${bounded} --word 0x70012c 1 --word 0x70012e 256
                --word 0x700130 ${greater} --word 0x700132 ${byte} --word 0x700134 8 --word 0x700136 ${color}
                --word 0x700138 ${pointer_result}
                --word 0x700180 ${tick} --word 0x700182 ${factor} --writes 0x700180 4 --writes 0x700182 8
                --screen-mode 0 --screen-base 16 --plots 0 3 --rpix 0 2 --register 0 42 --register 6 0 --register 10 0x1ffc)
        endforeach()
    endforeach()
endforeach()

# Scalarization must not turn an illegal packed word access into a valid SSA
# value, nor remove the preceding volatile witness or execute following work.
file(WRITE "${TEST_DIR}/packed.dc" "@packed struct P{byte a;word b;};word main(){*(volatile word*)0x120=7;struct P p;p.a=1;word* q=(word*)((byte*)&p+1);*q=42;*(volatile word*)0x120=9;return 42;}")
foreach(level IN ITEMS 0 1 2)
    set(OPTIMIZATION ${level})
    check_round_trip("packed-${level}" "${TEST_DIR}/packed.dc" ${link})
    foreach(suffix IN ITEMS "" "-asm")
        run_command("${GSU_RUNNER}" "${TEST_DIR}/packed-${level}${suffix}.bin" 0x008000
            --word 0x700120 7 --writes 0x700120 1 --register 6 1)
    endforeach()
endforeach()
