cmake_minimum_required(VERSION 3.20)
if(PROFILE_GSU AND NOT MEASURE_GSU_TIMING)
    message(FATAL_ERROR "PROFILE_GSU requires MEASURE_GSU_TIMING=ON")
endif()
if(MEASURE_GSU_TIMING AND NOT VERIFY_MESEN)
    message(FATAL_ERROR "MEASURE_GSU_TIMING requires VERIFY_MESEN=ON")
endif()
if(NOT DEFINED OPTIMIZATION)
    set(OPTIMIZATION 2)
endif()
set(DEMO_OUTPUT_SUBDIR "build/plot-scaling-triangle")
include("${CMAKE_CURRENT_LIST_DIR}/../snes_demo_helpers.cmake")

message(STATUS "Compiling the scaling rainbow triangle and comparing both assembly paths")
if(NOT DEFINED TRIANGLE_SOURCE)
    set(TRIANGLE_SOURCE "${CMAKE_CURRENT_LIST_DIR}/triangle.dc")
endif()
get_filename_component(TRIANGLE_SOURCE "${TRIANGLE_SOURCE}" ABSOLUTE)
build_gsu_payload("${TRIANGLE_SOURCE}")
file(READ "${OUTPUT_DIR}/triangle.s" assembly)
if(NOT assembly MATCHES "__DISCO_BITMAP_SCBR[ \t]+\\$00" OR
   NOT assembly MATCHES "__DISCO_BITMAP_SCMR[ \t]+\\$21" OR
   NOT assembly MATCHES "__DISCO_CODE_START_ADDRESS[ \t]+\\$706000")
    message(FATAL_ERROR "The SNES host requires 4bpp/256x192 at SCBR=0 and GSU origin $70:6000")
endif()
build_snes_host("${CMAKE_CURRENT_LIST_DIR}" scaling-triangle)
build_snes_host("${CMAKE_CURRENT_LIST_DIR}" scaling-triangle-negative -D FORCE_BAD_RESULT=1)

if(VERIFY_MESEN)
    # A failed run must not inherit captures from an earlier animation.
    file(REMOVE "${OUTPUT_DIR}/scaling-minimum.bmp" "${OUTPUT_DIR}/scaling-maximum.bmp")
    foreach(height RANGE 24 56)
        file(REMOVE "${OUTPUT_DIR}/scaling-height-${height}.bmp")
    endforeach()
    file(REMOVE "${OUTPUT_DIR}/scaling-negative-preview.png" "${OUTPUT_DIR}/scaling-failure.png")
    file(REMOVE "${OUTPUT_DIR}/fps.json" "${OUTPUT_DIR}/fps-error.log")
    file(WRITE "${OUTPUT_DIR}/fps-config.lua" "return {verifier=[=[${CMAKE_CURRENT_LIST_DIR}/verify.lua]=]}\n")
    if(MEASURE_GSU_TIMING)
        file(REMOVE "${OUTPUT_DIR}/profile-config.lua" "${OUTPUT_DIR}/profile.json")
        file(READ "${OUTPUT_DIR}/triangle.s" assembly)
        string(REGEX MATCH "(ibt|iwt) r6, #\\$0+ [^\n]+\n    stop ; CODE\\+\\$[0-9A-F]+" normal_stop "${assembly}")
        if(NOT normal_stop)
            message(FATAL_ERROR "Missing normal main STOP for GSU timing")
        endif()
        string(REGEX MATCH "stop ; CODE\\+\\$([0-9A-F]+)" stop_match "${normal_stop}")
        math(EXPR stop_address "0x706000 + 0x${CMAKE_MATCH_1}" OUTPUT_FORMAT HEXADECIMAL)
        file(SIZE "${OUTPUT_DIR}/triangle.bin" payload_bytes)
        file(SIZE "${OUTPUT_DIR}/scaling-triangle.sfc" rom_bytes)
        file(SHA256 "${OUTPUT_DIR}/triangle.bin" payload_sha256)
        file(SHA256 "${TRIANGLE_SOURCE}" source_sha256)
        file(REMOVE "${OUTPUT_DIR}/timing.json" "${OUTPUT_DIR}/timing-error.log")
        file(WRITE "${OUTPUT_DIR}/timing-config.lua"
            "return {level='O${OPTIMIZATION}', origin=0x706000, stop_address=${stop_address}, payload_bytes=${payload_bytes}, rom_bytes=${rom_bytes}, payload_sha256='${payload_sha256}', source_sha256='${source_sha256}', fps_probe=[=[${CMAKE_CURRENT_LIST_DIR}/../rotating_triangle/measure-fps.lua]=]}\n")
        if(PROFILE_GSU)
            include("${ROOT_DIR}/benchmarks/mesen/build-profile-map.cmake")
            gsu_profile_map("${OUTPUT_DIR}/triangle.s" 7364608 ${payload_bytes} "${OUTPUT_DIR}/profile-map.lua")
            file(REMOVE "${OUTPUT_DIR}/profile.json")
            # Timing config is data generated by this script, not a source edit.
            file(WRITE "${OUTPUT_DIR}/profile-config.lua"
                "return {map=[=[${OUTPUT_DIR}/profile-map.lua]=], script=[=[${ROOT_DIR}/benchmarks/mesen/gsu-profile.lua]=]}\n")
        endif()
    endif()
    set(mesen_options --testrunner --timeout=120 --doNotSaveSettings
        --snes.region=Ntsc --snes.gsuClockSpeed=100 --snes.enableRandomPowerOnState=false
        --snes.ppuExtraScanlinesBeforeNmi=0 --snes.ppuExtraScanlinesAfterNmi=0
        --snes.disableFrameSkipping=true --debug.scriptWindow.allowIoOsAccess=true)
    foreach(suffix IN ITEMS "" "-negative")
        file(REMOVE "${OUTPUT_DIR}/scaling-triangle${suffix}-verification.log")
        if(suffix STREQUAL "")
            if(MEASURE_GSU_TIMING)
                set(verifier "${ROOT_DIR}/benchmarks/mesen/measure-rotation.lua")
            else()
                set(verifier "${CMAKE_CURRENT_LIST_DIR}/../rotating_triangle/measure-fps.lua")
            endif()
        else()
            set(verifier "${CMAKE_CURRENT_LIST_DIR}/verify-negative.lua")
        endif()
        run_command("${MESEN}" ${mesen_options}
            "${verifier}"
            "${OUTPUT_DIR}/scaling-triangle${suffix}.sfc")
        if(NOT EXISTS "${OUTPUT_DIR}/scaling-triangle${suffix}-verification.log")
            message(FATAL_ERROR "Mesen produced no verification evidence for the scaling triangle${suffix}")
        endif()
        file(READ "${OUTPUT_DIR}/scaling-triangle${suffix}-verification.log" evidence)
        if(suffix STREQUAL "")
            set(expected "^PASS scaling triangle: 64 phases plus wrap,")
        else()
            set(expected "^PASS scaling triangle negative:")
        endif()
        if(NOT evidence MATCHES "${expected}")
            message(FATAL_ERROR "Mesen verification failed: ${evidence}")
        endif()
        string(STRIP "${evidence}" evidence)
        message(STATUS "${evidence}")
    endforeach()
    if(NOT EXISTS "${OUTPUT_DIR}/fps.json" OR EXISTS "${OUTPUT_DIR}/fps-error.log")
        message(FATAL_ERROR "Missing/failed completed-frame FPS measurement")
    endif()
    if(MEASURE_GSU_TIMING)
        if(NOT EXISTS "${OUTPUT_DIR}/timing.json" OR EXISTS "${OUTPUT_DIR}/timing-error.log")
            message(FATAL_ERROR "Missing/failed GSU boundary timing measurement")
        endif()
        file(READ "${OUTPUT_DIR}/timing.json" timing)
        string(JSON sample_count LENGTH "${timing}" samples)
        if(NOT sample_count EQUAL 65)
            message(FATAL_ERROR "GSU timing did not record all 64 poses plus wrap")
        endif()
        if(PROFILE_GSU)
            if(NOT EXISTS "${OUTPUT_DIR}/profile.json")
                message(FATAL_ERROR "Missing GSU region profile")
            endif()
            file(SIZE "${OUTPUT_DIR}/profile.json" profile_size)
            if(profile_size GREATER 2097152)
                message(FATAL_ERROR "Oversized GSU region profile")
            endif()
            file(READ "${OUTPUT_DIR}/profile.json" profile)
            string(JSON instructions GET "${profile}" instructions)
            string(JSON clocks GET "${timing}" samples 0 gsu_cycles)
            gsu_validate_profile("${profile}" ${clocks} ${instructions})
        endif()
    endif()
    foreach(size IN ITEMS minimum maximum)
        if(NOT EXISTS "${OUTPUT_DIR}/scaling-${size}.bmp")
            message(FATAL_ERROR "Missing captured scaling ${size}")
        endif()
    endforeach()
    foreach(height RANGE 24 56)
        if(NOT EXISTS "${OUTPUT_DIR}/scaling-height-${height}.bmp")
            message(FATAL_ERROR "Missing owned-screen capture for height ${height}")
        endif()
    endforeach()
    if(NOT EXISTS "${OUTPUT_DIR}/scaling-negative-preview.png")
        message(FATAL_ERROR "Mesen produced no screenshot for the deliberate failure path")
    endif()
endif()
message(STATUS "Open ${OUTPUT_DIR}/scaling-triangle.sfc to see the rainbow triangle growing and shrinking")
