// Exercises the IR/CFG lowering for conditional branches and loops.
word choose(word value) {
    if (value > 0) {
        return 1;
    } else {
        return 2;
    }
}

void touch(word value) {
    value = value + 1;
}

void main() {
    word result = choose(1);
    touch(result);
    while (result > 0) {
        result = result - 1;
    }
}
