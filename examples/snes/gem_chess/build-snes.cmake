cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED OPTIMIZATION)
    set(OPTIMIZATION 2)
endif()
if(NOT OPTIMIZATION MATCHES "^[2s]$")
    message(FATAL_ERROR "This bounded RAM scene host supports OPTIMIZATION=2 or s")
endif()
set(DEMO_OUTPUT_SUBDIR "build/gem-chess-scene")
include("${CMAKE_CURRENT_LIST_DIR}/../snes_demo_helpers.cmake")
build_gsu_payload("${CMAKE_CURRENT_LIST_DIR}/main.dc" "${CMAKE_CURRENT_LIST_DIR}/discoc.toml")
configure_file("${OUTPUT_DIR}/triangle.bin" "${OUTPUT_DIR}/gem-chess.bin" COPYONLY)
configure_file("${OUTPUT_DIR}/triangle.s" "${OUTPUT_DIR}/gem-chess.s" COPYONLY)
file(SIZE "${OUTPUT_DIR}/gem-chess.bin" payload_size)
if(payload_size GREATER 32768)
    message(FATAL_ERROR "Payload does not fit its LoROM source bank")
endif()
file(READ "${OUTPUT_DIR}/gem-chess.s" assembly)
foreach(field IN ITEMS CODE_START_ADDRESS BITMAP_SCBR BITMAP_SCMR)
    if(NOT assembly MATCHES "\\.define __DISCO_${field}[ \t]+\\$([0-9A-Fa-f]+)")
        message(FATAL_ERROR "Missing linked metadata: ${field}")
    endif()
    set(${field} "${CMAKE_MATCH_1}")
    math(EXPR ${field}_value "0x${${field}}")
endforeach()
if(NOT CODE_START_ADDRESS_value EQUAL 0x706000 OR
   NOT BITMAP_SCBR_value EQUAL 0 OR NOT BITMAP_SCMR_value EQUAL 33)
    message(FATAL_ERROR "Host requires $70:6000, bitmap 256x192, 4bpp, base zero")
endif()
file(WRITE "${OUTPUT_DIR}/scene-config.inc"
    ".DEFINE GSU_LOAD_ADDRESS $${CODE_START_ADDRESS}\n.DEFINE GSU_START_PC $6000\n"
    ".DEFINE BITMAP_SCBR $${BITMAP_SCBR}\n.DEFINE BITMAP_SCMR $${BITMAP_SCMR}\n")
string(REGEX MATCH "(ibt|iwt) r6, #\\$0+ [^\n]+\n    stop ; CODE\\+\\$([0-9A-F]+)" stop_match "${assembly}")
if(NOT stop_match)
    message(FATAL_ERROR "Missing normal main STOP for timing/ABI validation")
endif()
math(EXPR stop_address "${CODE_START_ADDRESS_value} + 0x${CMAKE_MATCH_2}" OUTPUT_FORMAT HEXADECIMAL)
file(WRITE "${OUTPUT_DIR}/scene-test-config.lua" "return {stop=${stop_address},bytes=${payload_size}}\n")
configure_file("${CMAKE_CURRENT_LIST_DIR}/geometry-checks.lua" "${OUTPUT_DIR}/geometry-checks.lua" COPYONLY)
build_snes_host("${CMAKE_CURRENT_LIST_DIR}" gem-chess)
build_snes_host("${CMAKE_CURRENT_LIST_DIR}" gem-chess-negative -D FORCE_BAD_RESULT=1)
if(VERIFY_MESEN)
    foreach(suffix IN ITEMS "" "-negative")
        file(REMOVE "${OUTPUT_DIR}/gem-chess${suffix}-verification.log")
        if(suffix STREQUAL "")
            set(script verify.lua)
        else()
            set(script verify-negative.lua)
        endif()
        run_command("${MESEN}" --testrunner --timeout=120 --doNotSaveSettings
            --snes.region=Ntsc --snes.gsuClockSpeed=100 --snes.enableRandomPowerOnState=false
            --snes.ppuExtraScanlinesBeforeNmi=0 --snes.ppuExtraScanlinesAfterNmi=0
            --snes.disableFrameSkipping=true --debug.scriptWindow.allowIoOsAccess=true
            "${CMAKE_CURRENT_LIST_DIR}/${script}" "${OUTPUT_DIR}/gem-chess${suffix}.sfc")
        if(NOT EXISTS "${OUTPUT_DIR}/gem-chess${suffix}-verification.log")
            message(FATAL_ERROR "Mesen did not produce verification evidence")
        endif()
        file(READ "${OUTPUT_DIR}/gem-chess${suffix}-verification.log" evidence)
        if(NOT evidence MATCHES "^PASS gem chess")
            message(FATAL_ERROR "${evidence}")
        endif()
        message(STATUS "${evidence}")
    endforeach()
endif()
message(STATUS "ROM: ${OUTPUT_DIR}/gem-chess.sfc (${payload_size}-byte GSU payload)")
